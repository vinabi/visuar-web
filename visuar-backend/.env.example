# Copy to .env and fill in values

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres
GEMINI_API_KEY=your-gemini-key

API_HOST=0.0.0.0
API_PORT=8000

# Email (Gmail SMTP) — set on Hugging Face Space secrets/variables
EMAIL_USER=your@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_APP_URL=https://your-frontend-domain.com
EMAIL_TIMEZONE=Asia/Karachi
EMAIL_FROM_NAME=VISUAR
